{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sris",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-13",
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": false }
  ],
  "triggers": {
    "crons": ["15 23 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "SRIS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sris-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "env": {
    "staging": {
      "name": "sris-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_NAME": "SRIS (staging)"
      },
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sris-db-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID"
        }
      ]
    }
  }
}
